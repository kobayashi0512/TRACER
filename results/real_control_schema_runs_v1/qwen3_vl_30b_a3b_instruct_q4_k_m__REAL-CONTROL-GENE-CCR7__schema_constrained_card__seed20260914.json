    "response": "{\n  \"candidate_id\": \"cand-CCR7-melanoma-antiPD1\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy / nivolumab direction check\",\n    \"analysis_unit\": \"Lesion-level single-cell pseudo-bulk and independent bulk-RNA sample summary\"\n  },\n  \"hypotheses\": [\n    {\n      \"id\": \"hypothesis_a\",\n      \"statement\": \"The higher expression of CCR7 in responders reflects a pre-existing, functional T-cell state associated with improved response to anti-PD-1 therapy.\",\n      \"falsifiable_prediction\": \"Inhibition of CCR7 signaling in pre-treatment tumor-infiltrating lymphocytes will reduce anti-PD-1 response in a humanized mouse model of melanoma.\"\n    },\n    {\n      \"id\": \"hypothesis_b\",\n      \"statement\": \"The association between CCR7 expression and response is a correlative artifact driven by confounding factors such as tumor-infiltrating lymphocyte (TIL) abundance or spatial distribution, rather than a causal or mechanistic role of CCR7.\",\n      \"falsifiable_prediction\": \"After adjusting for TIL abundance or spatial heterogeneity, the association between CCR7 expression and response will no longer be significant in the GSE120575 cohort.\"\n    }\n  ],\n  \"evidence_sources\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/positive_control_screen_v1.tsv#feature=gene:CCR7\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv#feature=gene:CCR7\",\n      \"supports_or_refutes\": \"supports\"\n    }\n  ],\n  \"cross_cohort_replication\": {\n    \"independent_cohorts\": 2,\n    \"cohort_ids\": [\n      \"GSE120575\",\n      \"GSE91061\"\n    ],\n    \"effect_direction_consistent\": true,\n    \"same_biological_compartment\": true,\n    \"same_measurement_level\": false,\n    \"discovery_fdr\": 0.048486,\n    \"validation_fdr\": 0.262387\n  },\n  \"perturbation_support\": {\n    \"tested\": false,\n    \"direction_consistent\": false,\n    \"independent_studies\": 0\n  },\n  \"orthogonal_evidence\": {\n    \"modalities\": 2,\n    \"direction_consistent\": true\n  },\n  \"curated_literature_evidence\": {\n    \"independent_sources\": 0,\n    \"supports_claim\": false\n  },\n  \"confounding_robustness\": {\n    \"batch_controlled\": false,\n    \"composition_controlled\": false\n  },\n  \"discriminating_experiment\": {\n    \"intervention\": \"CCR7 signaling inhibition (e.g., anti-CCR7 antibody or CCR7-KO T cells)\",\n    \"comparator\": \"Control (isotype antibody or wild-type T cells)\",\n    \"readout\": \"Tumor growth rate and immune cell infiltration in a humanized melanoma mouse model treated with anti-PD-1\",\n    \"prediction_if_hypothesis_a\": \"CCR7 inhibition will reduce anti-PD-1 response, resulting in faster tumor growth and reduced T-cell infiltration compared to control.\",\n    \"prediction_if_hypothesis_b\": \"CCR7 inhibition will not alter anti-PD-1 response, as the association is confounded and not mechanistically causal.\"\n  }\n}",
