    "response": "{\n  \"candidate_id\": \"REAL-TRANSPORT-GENE-LAG3\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy across audited cohorts\",\n    \"analysis_unit\": \"Discovery lesion-level single-cell summary plus two independent bulk-RNA sample summaries\"\n  },\n  \"hypotheses\": [\n    {\n      \"id\": \"hypothesis-1\",\n      \"statement\": \"The observed higher expression of LAG3 in non-responders across the single-cell discovery cohort and one bulk cohort reflects a baseline immune-exhausted state that is predictive of poor response to anti-PD-1 therapy.\",\n      \"falsifiable_prediction\": \"In a new independent cohort of melanoma patients pre-treated with anti-PD-1, LAG3 expression in pre-treatment tumor samples will be significantly higher in non-responders compared to responders.\"\n    },\n    {\n      \"id\": \"hypothesis-2\",\n      \"statement\": \"The inconsistent direction of LAG3 expression between cohorts indicates that LAG3 is not a core mechanistic driver of anti-PD-1 response but rather a confounded or context-dependent biomarker influenced by technical or biological variability.\",\n      \"falsifiable_prediction\": \"In a new independent cohort of melanoma patients pre-treated with anti-PD-1, LAG3 expression will not show a consistent directional association with response status, and the effect will be non-significant or directionally reversed.\"\n    }\n  ],\n  \"evidence_sources\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/positive_control_screen_v1.tsv#feature=gene:LAG3\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv#feature=gene:LAG3\",\n      \"supports_or_refutes\": \"refutes\"\n    },\n    {\n      \"id\": \"gse78220-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse78220_positive_control_direction_check_v1.tsv#feature=gene:LAG3\",\n      \"supports_or_refutes\": \"supports\"\n    }\n  ],\n  \"cross_cohort_replication\": {\n    \"independent_cohorts\": 2,\n    \"cohort_ids\": [\n      \"GSE91061\",\n      \"GSE78220\"\n    ],\n    \"effect_direction_consistent\": false,\n    \"same_biological_compartment\": true,\n    \"same_measurement_level\": false,\n    \"discovery_fdr\": 0.060606,\n    \"validation_fdr\": 0.312168\n  },\n  \"perturbation_support\": {\n    \"tested\": false,\n    \"direction_consistent\": false,\n    \"independent_studies\": 0\n  },\n  \"orthogonal_evidence\": {\n    \"modalities\": 2,\n    \"direction_consistent\": false\n  },\n  \"curated_literature_evidence\": {\n    \"independent_sources\": 0,\n    \"supports_claim\": false\n  },\n  \"confounding_robustness\": {\n    \"batch_controlled\": false,\n    \"composition_controlled\": false\n  },\n  \"discriminating_experiment\": {\n    \"intervention\": \"Single-cell RNA sequencing of pre-treatment tumor biopsies from a new cohort of melanoma patients treated with anti-PD-1 monotherapy\",\n    \"comparator\": \"Bulk RNA sequencing of the same pre-treatment tumor biopsies\",\n    \"readout\": \"Direction of LAG3 expression in responder versus non-responder groups\",\n    \"prediction_if_hypothesis_a\": \"LAG3 expression will be higher in non-responders in both single-cell and bulk data, with consistent direction across modalities.\",\n    \"prediction_if_hypothesis_b\": \"LAG3 expression will show inconsistent direction between single-cell and bulk data, or no consistent direction across modalities.\"\n  }\n}",
