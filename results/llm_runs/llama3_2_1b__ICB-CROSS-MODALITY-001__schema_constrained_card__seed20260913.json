  "prompt": "You are drafting a biomedical research candidate card, not making a clinical decision.\n\nUse only the model-visible evidence packet supplied below. Return one JSON object conforming to the candidate-card contract. Every evidence identifier must come from the packet, and every evidence item in the packet must be represented exactly once in `evidence_sources`; do not omit contradictory evidence. Give at least two competing, falsifiable hypotheses and a single experiment whose predictions differ between them.\n\nSet evidence fields conservatively. Do not assert causal support without an explicitly supplied direction-consistent perturbation result. Do not assert same-measurement replication when the packet does not explicitly establish it. Do not provide treatment recommendations. If the available evidence is insufficient, return a structurally complete LOW-evidence card rather than inventing missing evidence.\n\nMODEL-VISIBLE EVIDENCE PACKET\n{\n  \"packet_id\": \"ICB-CROSS-MODALITY-001\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy\",\n    \"analysis_unit\": \"Lesion-level summary\"\n  },\n  \"question\": \"Do the observed memory/exhaustion control-program differences establish a cell-state mechanism of anti-PD-1 response?\",\n  \"evidence_items\": [\n    {\n      \"id\": \"discovery-memory-exhaustion\",\n      \"cohort_id\": \"GSE120575\",\n      \"result_type\": \"single_cell_lesion_pseudobulk_control_screen\",\n      \"statement\": \"All 15 pre-specified control features had their expected responder/non-responder direction in the frozen discovery analysis.\",\n      \"effect_direction\": \"pre_registered_expected_direction\",\n      \"source_identifier\": \"results/positive_control_screen_v1.tsv\",\n      \"evidence_kind\": \"observational_association\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": false,\n      \"fdr\": 0.0485\n    },\n    {\n      \"id\": \"external-bulk-direction-check\",\n      \"cohort_id\": \"GSE91061\",\n      \"result_type\": \"bulk_rna_direction_check\",\n      \"statement\": \"Eight of 15 pre-specified control features matched the discovery direction; the exhausted program was directionally opposite overall.\",\n      \"effect_direction\": \"mixed_or_opposite\",\n      \"source_identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv\",\n      \"evidence_kind\": \"observational_association\",\n      \"direction_status\": \"mixed\",\n      \"confounding_assessed\": false,\n      \"fdr\": null\n    }\n  ]\n}\n\nCANDIDATE-CARD CONTRACT\n{\n  \"contract_id\": \"icb-disambiguate-candidate-card-v1\",\n  \"purpose\": \"Machine-checkable contract for an LLM-generated research hypothesis card. Passing the contract does not validate biology.\",\n  \"required_top_level_fields\": [\n    \"candidate_id\",\n    \"scope\",\n    \"hypotheses\",\n    \"evidence_sources\",\n    \"cross_cohort_replication\",\n    \"perturbation_support\",\n    \"orthogonal_evidence\",\n    \"curated_literature_evidence\",\n    \"confounding_robustness\",\n    \"discriminating_experiment\"\n  ],\n  \"scope_required_fields\": [\n    \"disease\",\n    \"treatment\",\n    \"analysis_unit\"\n  ],\n  \"hypothesis_constraints\": {\n    \"min_count\": 2,\n    \"required_fields\": [\n      \"id\",\n      \"statement\",\n      \"falsifiable_prediction\"\n    ]\n  },\n  \"evidence_source_required_fields\": [\n    \"id\",\n    \"source_type\",\n    \"identifier\",\n    \"supports_or_refutes\"\n  ],\n  \"cross_cohort_replication_required_fields\": [\n    \"independent_cohorts\",\n    \"cohort_ids\",\n    \"effect_direction_consistent\",\n    \"same_biological_compartment\",\n    \"same_measurement_level\",\n    \"discovery_fdr\",\n    \"validation_fdr\"\n  ],\n  \"discriminating_experiment_required_fields\": [\n    \"intervention\",\n    \"comparator\",\n    \"readout\",\n    \"prediction_if_hypothesis_a\",\n    \"prediction_if_hypothesis_b\"\n  ],\n  \"prohibited_interpretations\": [\n    \"Clinical treatment recommendation\",\n    \"Causal conclusion without perturbation evidence\",\n    \"Cross-modality result claimed as same-compartment replication\"\n  ]\n}\n",
