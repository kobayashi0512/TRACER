    "response": "{\n  \"candidate_id\": \"candidate-001\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy across audited cohorts\",\n    \"analysis_unit\": \"Discovery lesion-level single-cell summary plus two independent bulk-RNA sample summaries\"\n  },\n  \"hypotheses\": [\n    {\n      \"id\": \"hypothesis-a\",\n      \"statement\": \"The increased expression of gene:SELL in responders is a direct consequence of anti-PD-1 therapy-induced T-cell activation and infiltration, and thus serves as a biomarker of effective immune engagement.\",\n      \"falsifiable_prediction\": \"In a pre-treatment setting, higher SELL expression in tumor lesions correlates with improved clinical response to anti-PD-1 therapy.\"\n    },\n    {\n      \"id\": \"hypothesis-b\",\n      \"statement\": \"The observed SELL expression in responders reflects a pre-existing, therapy-independent immune cell state that is associated with better outcomes, rather than being caused by therapy.\",\n      \"falsifiable_prediction\": \"In a pre-treatment setting, SELL expression is higher in responders regardless of therapy, and the association persists even when controlling for baseline immune infiltration.\"\n    }\n  ],\n  \"evidence_sources\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"source_type\": \"lesion_level_single_cell_pseudobulk_positive_control\",\n      \"identifier\": \"results/positive_control_screen_v1.tsv#feature=gene:SELL\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"source_type\": \"pre_treatment_bulk_rna_direction_check\",\n      \"identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv#feature=gene:SELL\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse78220-bulk-direction-check\",\n      \"source_type\": \"pre_treatment_bulk_rna_direction_check\",\n      \"identifier\": \"results/gse78220_positive_control_direction_check_v1.tsv#feature=gene:SELL\",\n      \"supports_or_refutes\": \"supports\"\n    }\n  ],\n  \"cross_cohort_replication\": {\n    \"independent_cohorts\": 3,\n    \"cohort_ids\": [\n      \"GSE120575\",\n      \"GSE91061\",\n      \"GSE78220\"\n    ],\n    \"effect_direction_consistent\": true,\n    \"same_biological_compartment\": false,\n    \"same_measurement_level\": false,\n    \"discovery_fdr\": 0.048486,\n    \"validation_fdr\": 0.262387\n  },\n  \"perturbation_support\": {\n    \"tested\": false,\n    \"direction_consistent\": false,\n    \"independent_studies\": 0\n  },\n  \"orthogonal_evidence\": {\n    \"modalities\": 2,\n    \"direction_consistent\": true\n  },\n  \"curated_literature_evidence\": {\n    \"independent_sources\": 0,\n    \"supports_claim\": false\n  },\n  \"confounding_robustness\": {\n    \"batch_controlled\": false,\n    \"composition_controlled\": false\n  },\n  \"discriminating_experiment\": {\n    \"intervention\": \"Anti-PD-1 therapy\",\n    \"comparator\": \"Placebo or no treatment\",\n    \"readout\": \"Change in SELL expression in tumor-infiltrating T cells from pre- to post-treatment\",\n    \"prediction_if_hypothesis_a\": \"SELL expression increases significantly in responders after anti-PD-1 therapy, indicating therapy-induced activation.\",\n    \"prediction_if_hypothesis_b\": \"SELL expression remains stable or shows no significant change post-therapy, indicating that the baseline state is the primary driver of response.\"\n  }\n}",
