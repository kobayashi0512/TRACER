  "prompt": "You are drafting a biomedical research candidate card, not making a clinical decision.\n\nUse only the model-visible evidence packet supplied below. Return one JSON object conforming to the candidate-card contract. Every evidence identifier must come from the packet, and every evidence item in the packet must be represented exactly once in `evidence_sources`; do not omit contradictory evidence. Give at least two competing, falsifiable hypotheses and a single experiment whose predictions differ between them.\n\nSet evidence fields conservatively. Do not assert causal support without an explicitly supplied direction-consistent perturbation result. Do not assert same-measurement replication when the packet does not explicitly establish it. Do not provide treatment recommendations. If the available evidence is insufficient, return a structurally complete LOW-evidence card rather than inventing missing evidence.\n\nMODEL-VISIBLE EVIDENCE PACKET\n{\n  \"packet_id\": \"REAL-TRANSPORT-GENE-SELL\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy across audited cohorts\",\n    \"analysis_unit\": \"Discovery lesion-level single-cell summary plus two independent bulk-RNA sample summaries\"\n  },\n  \"question\": \"Do the observed gene:SELL directions across one single-cell discovery and two bulk response cohorts establish a replicated cell-state mechanism of anti-PD-1 response?\",\n  \"evidence_items\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"cohort_id\": \"GSE120575\",\n      \"result_type\": \"lesion_level_single_cell_pseudobulk_positive_control\",\n      \"statement\": \"For gene:SELL, responder minus non-responder was 1.47318 and the observed higher group was Responder (pre-specified expected group: Responder; panel BH q=0.048486).\",\n      \"effect_direction\": \"Responder\",\n      \"source_identifier\": \"results/positive_control_screen_v1.tsv#feature=gene:SELL\",\n      \"evidence_kind\": \"observational_association\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": false,\n      \"fdr\": 0.048486\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"cohort_id\": \"GSE91061\",\n      \"result_type\": \"pre_treatment_bulk_rna_direction_check\",\n      \"statement\": \"For gene:SELL, GSE91061 bulk RNA observed Responder versus the pre-specified expected group Responder (panel BH q=0.262387).\",\n      \"effect_direction\": \"Responder\",\n      \"source_identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv#feature=gene:SELL\",\n      \"evidence_kind\": \"observational_association\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": false,\n      \"fdr\": 0.262387\n    },\n    {\n      \"id\": \"gse78220-bulk-direction-check\",\n      \"cohort_id\": \"GSE78220\",\n      \"result_type\": \"pre_treatment_bulk_rna_direction_check\",\n      \"statement\": \"For gene:SELL, GSE78220 bulk RNA observed Responder versus the pre-specified expected group Responder (panel BH q=0.980536).\",\n      \"effect_direction\": \"Responder\",\n      \"source_identifier\": \"results/gse78220_positive_control_direction_check_v1.tsv#feature=gene:SELL\",\n      \"evidence_kind\": \"observational_association\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": false,\n      \"fdr\": 0.980536\n    }\n  ]\n}\n\nCANDIDATE-CARD CONTRACT\n{\n  \"contract_id\": \"icb-disambiguate-candidate-card-v1\",\n  \"purpose\": \"Machine-checkable contract for an LLM-generated research hypothesis card. Passing the contract does not validate biology.\",\n  \"required_top_level_fields\": [\n    \"candidate_id\",\n    \"scope\",\n    \"hypotheses\",\n    \"evidence_sources\",\n    \"cross_cohort_replication\",\n    \"perturbation_support\",\n    \"orthogonal_evidence\",\n    \"curated_literature_evidence\",\n    \"confounding_robustness\",\n    \"discriminating_experiment\"\n  ],\n  \"scope_required_fields\": [\n    \"disease\",\n    \"treatment\",\n    \"analysis_unit\"\n  ],\n  \"hypothesis_constraints\": {\n    \"min_count\": 2,\n    \"required_fields\": [\n      \"id\",\n      \"statement\",\n      \"falsifiable_prediction\"\n    ]\n  },\n  \"evidence_source_required_fields\": [\n    \"id\",\n    \"source_type\",\n    \"identifier\",\n    \"supports_or_refutes\"\n  ],\n  \"cross_cohort_replication_required_fields\": [\n    \"independent_cohorts\",\n    \"cohort_ids\",\n    \"effect_direction_consistent\",\n    \"same_biological_compartment\",\n    \"same_measurement_level\",\n    \"discovery_fdr\",\n    \"validation_fdr\"\n  ],\n  \"discriminating_experiment_required_fields\": [\n    \"intervention\",\n    \"comparator\",\n    \"readout\",\n    \"prediction_if_hypothesis_a\",\n    \"prediction_if_hypothesis_b\"\n  ],\n  \"prohibited_interpretations\": [\n    \"Clinical treatment recommendation\",\n    \"Causal conclusion without perturbation evidence\",\n    \"Cross-modality result claimed as same-compartment replication\"\n  ]\n}\n",
