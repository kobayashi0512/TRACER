    "response": "{\n  \"candidate_id\": \"REAL-TRANSPORT-GENE-IL7R\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy across audited cohorts\",\n    \"analysis_unit\": \"Discovery lesion-level single-cell summary plus two independent bulk-RNA sample summaries\"\n  },\n  \"hypotheses\": [\n    {\n      \"id\": \"hypothesis-1\",\n      \"statement\": \"The observed upregulation of IL7R in responders across the discovery single-cell cohort and the GSE91061 bulk cohort reflects a true biological mechanism of anti-PD-1 response, with IL7R expression in tumor-infiltrating T cells promoting T-cell survival and effector function, thereby enhancing treatment response.\",\n      \"falsifiable_prediction\": \"In a new, independent cohort of melanoma patients treated with anti-PD-1, higher baseline IL7R expression in tumor tissue will be associated with improved response rates (e.g., objective response rate or progression-free survival).\"\n    },\n    {\n      \"id\": \"hypothesis-2\",\n      \"statement\": \"The inconsistent direction of IL7R expression between the GSE91061 and GSE78220 cohorts is due to technical or batch effects in bulk RNA-seq, and the observed association in the single-cell discovery cohort is a false positive driven by confounding factors such as cell-type composition differences or assay-specific noise, rather than a true biological mechanism.\",\n      \"falsifiable_prediction\": \"When controlling for cell-type composition and batch effects in a meta-analysis of the three cohorts, the association between IL7R expression and response status will no longer be significant, and the single-cell result will not replicate in an independent bulk-RNA cohort.\"\n    }\n  ],\n  \"evidence_sources\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/positive_control_screen_v1.tsv#feature=gene:IL7R\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv#feature=gene:IL7R\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse78220-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse78220_positive_control_direction_check_v1.tsv#feature=gene:IL7R\",\n      \"supports_or_refutes\": \"refutes\"\n    }\n  ],\n  \"cross_cohort_replication\": {\n    \"independent_cohorts\": 2,\n    \"cohort_ids\": [\n      \"GSE91061\",\n      \"GSE78220\"\n    ],\n    \"effect_direction_consistent\": false,\n    \"same_biological_compartment\": true,\n    \"same_measurement_level\": false,\n    \"discovery_fdr\": 0.933333,\n    \"validation_fdr\": 0.262387\n  },\n  \"perturbation_support\": {\n    \"tested\": false,\n    \"direction_consistent\": false,\n    \"independent_studies\": 0\n  },\n  \"orthogonal_evidence\": {\n    \"modalities\": 2,\n    \"direction_consistent\": false\n  },\n  \"curated_literature_evidence\": {\n    \"independent_sources\": 0,\n    \"supports_claim\": false\n  },\n  \"confounding_robustness\": {\n    \"batch_controlled\": false,\n    \"composition_controlled\": false\n  },\n  \"discriminating_experiment\": {\n    \"intervention\": \"Single-cell RNA-seq of pre-treatment tumor biopsies from a new cohort of melanoma patients treated with anti-PD-1 monotherapy\",\n    \"comparator\": \"Bulk RNA-seq of the same biopsies\",\n    \"readout\": \"IL7R expression level in tumor-infiltrating T cells\",\n    \"prediction_if_hypothesis_a\": \"IL7R expression in T cells will be significantly higher in responders compared to non-responders in both single-cell and bulk data, with consistent effect direction and statistical significance (FDR < 0.05).\",\n    \"prediction_if_hypothesis_b\": \"IL7R expression in T cells will show no consistent effect direction between single-cell and bulk data, and the association with response status will be non-significant or inconsistent after accounting for cell-type composition and batch effects.\"\n  }\n}",
