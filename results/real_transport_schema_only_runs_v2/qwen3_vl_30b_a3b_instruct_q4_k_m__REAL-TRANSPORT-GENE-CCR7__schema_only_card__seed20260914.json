    "response": "{\n  \"candidate_id\": \"REAL-TRANSPORT-GENE-CCR7\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy across audited cohorts\",\n    \"analysis_unit\": \"Discovery lesion-level single-cell summary plus two independent bulk-RNA sample summaries\"\n  },\n  \"hypotheses\": [\n    {\n      \"id\": \"hypothesis-1\",\n      \"statement\": \"Upregulation of CCR7 in pre-treatment tumor lesions is a replicated, causal driver of anti-PD-1 response in melanoma, indicating a functional role for CCR7+ T-cell trafficking in treatment efficacy.\",\n      \"falsifiable_prediction\": \"Knockdown of CCR7 in tumor-infiltrating T cells will reduce response to anti-PD-1 therapy in a preclinical melanoma model.\"\n    },\n    {\n      \"id\": \"hypothesis-2\",\n      \"statement\": \"The observed association of CCR7 with response is a correlative artifact driven by confounding immune cell composition differences between responders and non-responders, not a causal mechanism.\",\n      \"falsifiable_prediction\": \"Deconvolution of bulk RNA data to infer immune cell proportions will show that CCR7 expression is correlated with T-cell infiltration, and that the association with response disappears after adjusting for cell-type composition.\"\n    }\n  ],\n  \"evidence_sources\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/positive_control_screen_v1.tsv#feature=gene:CCR7\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv#feature=gene:CCR7\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse78220-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"resu