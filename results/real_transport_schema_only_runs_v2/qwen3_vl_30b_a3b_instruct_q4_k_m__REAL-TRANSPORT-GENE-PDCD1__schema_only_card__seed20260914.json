    "response": "{\n  \"candidate_id\": \"REAL-TRANSPORT-GENE-PDCD1\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy across audited cohorts\",\n    \"analysis_unit\": \"Discovery lesion-level single-cell summary plus two independent bulk-RNA sample summaries\"\n  },\n  \"hypotheses\": [\n    {\n      \"id\": \"hypothesis-1\",\n      \"statement\": \"The observed higher expression of PDCD1 in non-responders in the single-cell discovery cohort reflects a pre-existing exhausted T-cell state that is refractory to anti-PD-1 therapy, and this state is preserved in bulk RNA from non-responders, supporting a cell-state mechanism of resistance.\",\n      \"falsifiable_prediction\": \"In a new cohort of melanoma patients treated with anti-PD-1, bulk RNA from non-responders will show higher PDCD1 expression than responders, consistent with the single-cell discovery result.\"\n    },\n    {\n      \"id\": \"hypothesis-2\",\n      \"statement\": \"The discordant direction of PDCD1 expression between the single-cell discovery cohort and the bulk RNA cohorts reflects technical or biological confounding, such as differential immune infiltration or batch effects, and PDCD1 expression is not a consistent marker of a pre-treatment cell state predictive of response.\",\n      \"falsifiable_prediction\": \"In a new cohort of melanoma patients treated with anti-PD-1, bulk RNA from responders will show higher PDCD1 expression than non-responders, reversing the single-cell discovery trend.\"\n    }\n  ],\n  \"evidence_sources\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"source_type\": \"single_cell\",\n      \"identifier\": \"gse120575-discovery\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"source_type\": \"bulk_rna\",\n      \"identifier\": \"gse91061-bulk-direction-check\",\n      \"supports_or_refutes\": \"refutes\"\n    },\n    {\n     