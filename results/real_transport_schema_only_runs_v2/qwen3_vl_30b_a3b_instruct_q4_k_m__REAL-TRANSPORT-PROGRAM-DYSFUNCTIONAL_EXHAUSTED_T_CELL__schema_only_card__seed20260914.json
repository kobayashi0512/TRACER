    "response": "{\n  \"candidate_id\": \"REAL-TRANSPORT-PROGRAM-DYSFUNCTIONAL_EXHAUSTED_T_CELL\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy across audited cohorts\",\n    \"analysis_unit\": \"Discovery lesion-level single-cell summary plus two independent bulk-RNA sample summaries\"\n  },\n  \"hypotheses\": [\n    {\n      \"id\": \"hypothesis-1\",\n      \"statement\": \"The program:dysfunctional_exhausted_t_cell is a biomarker of resistance to anti-PD-1 therapy, with higher levels in non-responders due to intrinsic T-cell exhaustion limiting therapeutic reinvigoration.\",\n      \"falsifiable_prediction\": \"In a prospective validation cohort, higher baseline levels of program:dysfunctional_exhausted_t_cell will be associated with lower response rates to anti-PD-1 monotherapy.\"\n    },\n    {\n      \"id\": \"hypothesis-2\",\n      \"statement\": \"The program:dysfunctional_exhausted_t_cell reflects a pre-existing, therapy-responsive T-cell state, where its presence indicates a pool of T cells capable of reinvigoration upon PD-1 blockade, leading to better outcomes.\",\n      \"falsifiable_prediction\": \"In a prospective validation cohort, higher baseline levels of program:dysfunctional_exhausted_t_cell will be associated with higher response rates to anti-PD-1 monotherapy.\"\n    }\n  ],\n  \"evidence_sources\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/positive_control_screen_v1.tsv#feature=program:dysfunctional_exhausted_t_cell\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv#feature=program:dysfunctional_exhausted_t_cell\",\n      \"supports_or_refutes\": \"refutes\"\n    },\n    {\n      \"id\": \"gse78220-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse78220_positive_control_direction_check_v1.tsv#feature=program:dysfunctional_exhausted_t_cell\",\n      \"supports_or_refutes\": \"supports\"\n    }\n  ],\n  \"cross_cohort_replication\": {\n    \"independent_cohorts\": 2,\n    \"cohort_ids\": [\n      \"GSE91061\",\n      \"GSE78220\"\n    ],\n    \"effect_direction_consistent\": false,\n    \"same_biological_compartment\": true,\n    \"same_measurement_level\": false,\n    \"discovery_fdr\": 0.072728,\n    \"validation_fdr\": 0.262387\n  },\n  \"perturbation_support\": {\n    \"tested\": false,\n    \"direction_consistent\": false,\n    \"independent_studies\": 0\n  },\n  \"orthogonal_evidence\": {\n    \"modalities\": 2,\n    \"direction_consistent\": false\n  },\n  \"curated_literature_evidence\": {\n    \"independent_sources\": 0,\n    \"supports_claim\": false\n  },\n  \"confounding_robustness\": {\n    \"batch_controlled\": false,\n    \"composition_controlled\": false\n  },\n  \"discriminating_experiment\": {\n    \"intervention\": \"In vitro PD-1 blockade on patient-derived melanoma TILs\",\n    \"comparator\": \"Untreated control\",\n    \"readout\": \"Change in expression of program:dysfunctional_exhausted_t_cell signature (measured by bulk RNA-seq)\",\n    \"prediction_if_hypothesis_a\": \"No significant change in program:dysfunctional_exhausted_t_cell signature after PD-1 blockade, indicating resistance to reinvigoration.\",\n    \"prediction_if_hypothesis_b\": \"Significant decrease in program:dysfunctional_exhausted_t_cell signature after PD-1 blockade, indicating reinvigoration of exhausted T cells.\"\n  }\n}",
