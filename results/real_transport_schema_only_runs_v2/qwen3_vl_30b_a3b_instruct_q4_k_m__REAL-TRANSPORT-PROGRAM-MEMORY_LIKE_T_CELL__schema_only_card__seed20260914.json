    "response": "{\n  \"candidate_id\": \"REAL-TRANSPORT-PROGRAM-MEMORY_LIKE_T_CELL\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy across audited cohorts\",\n    \"analysis_unit\": \"Discovery lesion-level single-cell summary plus two independent bulk-RNA sample summaries\"\n  },\n  \"hypotheses\": [\n    {\n      \"id\": \"hypothesis_a\",\n      \"statement\": \"The program:memory_like_t_cell is a replicated, causal driver of anti-PD-1 response in melanoma, with higher expression in responders due to pre-existing functional T-cell memory.\",\n      \"falsifiable_prediction\": \"In a prospective validation cohort, higher baseline program:memory_like_t_cell activity will be associated with improved response to anti-PD-1 therapy.\"\n    },\n    {\n      \"id\": \"hypothesis_b\",\n      \"statement\": \"The observed directionality of program:memory_like_t_cell is a non-causal, confounded correlate of response, driven by batch effects or tumor microenvironment heterogeneity rather than a functional T-cell state.\",\n      \"falsifiable_prediction\": \"In a controlled experimental setting with matched tumor samples and standardized processing, the association between program:memory_like_t_cell and response will be lost or reversed.\"\n    }\n  ],\n  \"evidence_sources\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/positive_control_screen_v1.tsv#feature=program:memory_like_t_cell\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv#feature=program:memory_like_t_cell\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse78220-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse78220_positive_control_direction_check_v1.tsv#feature=program:memory_like_t_cell\",\n      \"supports_or_refutes\": \"refutes\"\n    }\n  ],\n  \"cross_cohort_replication\": {\n    \"independent_cohorts\": 2,\n    \"cohort_ids\": [\n      \"GSE91061\",\n      \"GSE78220\"\n    ],\n    \"effect_direction_consistent\": false,\n    \"same_biological_compartment\": true,\n    \"same_measurement_level\": false,\n    \"discovery_fdr\": 0.048486,\n    \"validation_fdr\": 0.29397\n  },\n  \"perturbation_support\": {\n    \"tested\": false,\n    \"direction_consistent\": false,\n    \"independent_studies\": 0\n  },\n  \"orthogonal_evidence\": {\n    \"modalities\": 2,\n    \"direction_consistent\": false\n  },\n  \"curated_literature_evidence\": {\n    \"independent_sources\": 0,\n    \"supports_claim\": false\n  },\n  \"confounding_robustness\": {\n    \"batch_controlled\": false,\n    \"composition_controlled\": false\n  },\n  \"discriminating_experiment\": {\n    \"intervention\": \"In vitro stimulation of T cells from melanoma patients with anti-PD-1 and measurement of program:memory_like_t_cell gene expression dynamics\",\n    \"comparator\": \"T cells from healthy donors or untreated melanoma patients\",\n    \"readout\": \"Expression of program:memory_like_t_cell signature genes at 24h and 72h post-stimulation\",\n    \"prediction_if_hypothesis_a\": \"Program:memory_like_t_cell expression will increase significantly in responder-derived T cells after anti-PD-1 stimulation compared to controls.\",\n    \"prediction_if_hypothesis_b\": \"No significant difference in program:memory_like_t_cell expression will be observed between responder-derived and control T cells after anti-PD-1 stimulation.\"\n  }\n}",
