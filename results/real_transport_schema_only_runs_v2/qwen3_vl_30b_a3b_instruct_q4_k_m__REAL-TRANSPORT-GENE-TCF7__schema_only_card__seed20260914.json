    "response": "{\n  \"candidate_id\": \"REAL-TRANSPORT-GENE-TCF7\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy across audited cohorts\",\n    \"analysis_unit\": \"Discovery lesion-level single-cell summary plus two independent bulk-RNA sample summaries\"\n  },\n  \"hypotheses\": [\n    {\n      \"id\": \"hypothesis-1\",\n      \"statement\": \"The observed upregulation of TCF7 in responders across the discovery single-cell cohort and the GSE91061 bulk cohort reflects a true, biologically relevant cell-state signature of anti-PD-1 response, and the discordant result in GSE78220 is due to technical or cohort-specific confounding factors.\",\n      \"falsifiable_prediction\": \"A new, independent bulk-RNA cohort with similar patient characteristics will show consistent upregulation of TCF7 in responders.\"\n    },\n    {\n      \"id\": \"hypothesis-2\",\n      \"statement\": \"The association of TCF7 with response is not a consistent cell-state mechanism but rather a spurious or context-dependent signal, with the directionality in GSE78220 indicating that TCF7 expression may be associated with non-response in certain biological or technical contexts.\",\n      \"falsifiable_prediction\": \"A new, independent bulk-RNA cohort will show no consistent direction of TCF7 expression in responders versus non-responders, or will show a direction opposite to the initial discovery.\"\n    }\n  ],\n  \"evidence_sources\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/positive_control_screen_v1.tsv#feature=gene:TCF7\",\n      \"supports_or_refutes\": \"supports\"\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"source_type\": \"observational_association\",\n      \"identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv#feature=gene:TCF7\",\n      \"supports_or_refutes\": \"supports\"\n 