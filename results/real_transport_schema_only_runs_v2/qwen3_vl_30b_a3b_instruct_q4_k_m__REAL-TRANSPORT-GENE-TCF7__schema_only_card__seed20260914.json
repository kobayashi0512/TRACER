  "prompt": "You are drafting a biomedical research candidate card, not providing clinical care.\n\nUse only the evidence packet supplied below. Return one JSON object that follows\nthe supplied response schema. Include two competing, falsifiable hypotheses,\nthe supplied evidence identifiers, and one experiment with opposing predicted\noutcomes. Do not provide a patient-level treatment recommendation.\n\nEVIDENCE PACKET\n{\n  \"packet_id\": \"REAL-TRANSPORT-GENE-TCF7\",\n  \"scope\": {\n    \"disease\": \"Melanoma\",\n    \"treatment\": \"Pre-treatment anti-PD-1 monotherapy across audited cohorts\",\n    \"analysis_unit\": \"Discovery lesion-level single-cell summary plus two independent bulk-RNA sample summaries\"\n  },\n  \"question\": \"Do the observed gene:TCF7 directions across one single-cell discovery and two bulk response cohorts establish a replicated cell-state mechanism of anti-PD-1 response?\",\n  \"evidence_items\": [\n    {\n      \"id\": \"gse120575-discovery\",\n      \"cohort_id\": \"GSE120575\",\n      \"result_type\": \"lesion_level_single_cell_pseudobulk_positive_control\",\n      \"statement\": \"For gene:TCF7, responder minus non-responder was 1.133475 and the observed higher group was Responder (pre-specified expected group: Responder; panel BH q=0.060606).\",\n      \"effect_direction\": \"Responder\",\n      \"source_identifier\": \"results/positive_control_screen_v1.tsv#feature=gene:TCF7\",\n      \"evidence_kind\": \"observational_association\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": false,\n      \"fdr\": 0.060606\n    },\n    {\n      \"id\": \"gse91061-bulk-direction-check\",\n      \"cohort_id\": \"GSE91061\",\n      \"result_type\": \"pre_treatment_bulk_rna_direction_check\",\n      \"statement\": \"For gene:TCF7, GSE91061 bulk RNA observed Responder versus the pre-specified expected group Responder (panel BH q=0.465596).\",\n      \"effect_direction\": \"Responder\",\n      \"source_identifier\": \"results/gse91061_positive_control_direction_check_v1.tsv#feature=gene:TCF7\",\n      \"evidence_kind\": \"observational_association\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": false,\n      \"fdr\": 0.465596\n    },\n    {\n      \"id\": \"gse78220-bulk-direction-check\",\n      \"cohort_id\": \"GSE78220\",\n      \"result_type\": \"pre_treatment_bulk_rna_direction_check\",\n      \"statement\": \"For gene:TCF7, GSE78220 bulk RNA observed Non-responder versus the pre-specified expected group Responder (panel BH q=0.72198).\",\n      \"effect_direction\": \"Non-responder\",\n      \"source_identifier\": \"results/gse78220_positive_control_direction_check_v1.tsv#feature=gene:TCF7\",\n      \"evidence_kind\": \"observational_association\",\n      \"direction_status\": \"mixed\",\n      \"confounding_assessed\": false,\n      \"fdr\": 0.72198\n    }\n  ]\n}\n",
