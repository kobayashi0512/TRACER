  "prompt": "You are drafting a biomedical research candidate card, not making a clinical decision.\n\nUse only the model-visible evidence packet supplied below. Return one JSON object conforming to the candidate-card contract. Every evidence identifier must come from the packet, and every evidence item in the packet must be represented exactly once in `evidence_sources`; do not omit contradictory evidence. Give at least two competing, falsifiable hypotheses and a single experiment whose predictions differ between them.\n\nSet evidence fields conservatively. Do not assert causal support without an explicitly supplied direction-consistent perturbation result. Do not assert same-measurement replication when the packet does not explicitly establish it. Do not provide treatment recommendations. If the available evidence is insufficient, return a structurally complete LOW-evidence card rather than inventing missing evidence.\n\nMODEL-VISIBLE EVIDENCE PACKET\n{\n  \"packet_id\": \"SYNTH-CONFOUNDING-001\",\n  \"scope\": {\n    \"disease\": \"Synthetic melanoma\",\n    \"treatment\": \"Synthetic baseline anti-PD-1\",\n    \"analysis_unit\": \"Lesion-level pseudo-bulk\"\n  },\n  \"question\": \"Can otherwise complete evidence be prioritized when cell-composition confounding remains unresolved?\",\n  \"evidence_items\": [\n    {\n      \"id\": \"sc-discovery\",\n      \"cohort_id\": \"SYN-SC-A\",\n      \"result_type\": \"synthetic_single_cell_pseudobulk\",\n      \"statement\": \"Discovery cohort association is direction-consistent but composition is not controlled.\",\n      \"effect_direction\": \"positive\",\n      \"source_identifier\": \"synthetic://confounding/sc-discovery\",\n      \"evidence_kind\": \"observational_association\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": false,\n      \"fdr\": 0.01\n    },\n    {\n      \"id\": \"sc-replication\",\n      \"cohort_id\": \"SYN-SC-B\",\n      \"result_type\": \"synthetic_single_cell_pseudobulk\",\n      \"statement\": \"Independent replication is direction-consistent but composition is not controlled.\",\n      \"effect_direction\": \"positive\",\n      \"source_identifier\": \"synthetic://confounding/sc-replication\",\n      \"evidence_kind\": \"replication\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": false,\n      \"fdr\": 0.02\n    },\n    {\n      \"id\": \"functional\",\n      \"cohort_id\": \"SYN-FUNCTION\",\n      \"result_type\": \"synthetic_perturbation\",\n      \"statement\": \"Functional perturbation supports the stated direction.\",\n      \"effect_direction\": \"positive\",\n      \"source_identifier\": \"synthetic://confounding/functional\",\n      \"evidence_kind\": \"perturbation\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": true,\n      \"fdr\": null\n    },\n    {\n      \"id\": \"literature-1\",\n      \"cohort_id\": \"SYN-LIT-1\",\n      \"result_type\": \"synthetic_curated_literature\",\n      \"statement\": \"Independent curated source supports the constrained claim.\",\n      \"effect_direction\": \"positive\",\n      \"source_identifier\": \"synthetic://confounding/literature-1\",\n      \"evidence_kind\": \"literature\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": true,\n      \"fdr\": null\n    },\n    {\n      \"id\": \"literature-2\",\n      \"cohort_id\": \"SYN-LIT-2\",\n      \"result_type\": \"synthetic_curated_literature\",\n      \"statement\": \"A second independent curated source supports the constrained claim.\",\n      \"effect_direction\": \"positive\",\n      \"source_identifier\": \"synthetic://confounding/literature-2\",\n      \"evidence_kind\": \"literature\",\n      \"direction_status\": \"consistent\",\n      \"confounding_assessed\": true,\n      \"fdr\": null\n    }\n  ]\n}\n\nCANDIDATE-CARD CONTRACT\n{\n  \"contract_id\": \"icb-disambiguate-candidate-card-v1\",\n  \"purpose\": \"Machine-checkable contract for an LLM-generated research hypothesis card. Passing the contract does not validate biology.\",\n  \"required_top_level_fields\": [\n    \"candidate_id\",\n    \"scope\",\n    \"hypotheses\",\n    \"evidence_sources\",\n    \"cross_cohort_replication\",\n    \"perturbation_support\",\n    \"orthogonal_evidence\",\n    \"curated_literature_evidence\",\n    \"confounding_robustness\",\n    \"discriminating_experiment\"\n  ],\n  \"scope_required_fields\": [\n    \"disease\",\n    \"treatment\",\n    \"analysis_unit\"\n  ],\n  \"hypothesis_constraints\": {\n    \"min_count\": 2,\n    \"required_fields\": [\n      \"id\",\n      \"statement\",\n      \"falsifiable_prediction\"\n    ]\n  },\n  \"evidence_source_required_fields\": [\n    \"id\",\n    \"source_type\",\n    \"identifier\",\n    \"supports_or_refutes\"\n  ],\n  \"cross_cohort_replication_required_fields\": [\n    \"independent_cohorts\",\n    \"cohort_ids\",\n    \"effect_direction_consistent\",\n    \"same_biological_compartment\",\n    \"same_measurement_level\",\n    \"discovery_fdr\",\n    \"validation_fdr\"\n  ],\n  \"discriminating_experiment_required_fields\": [\n    \"intervention\",\n    \"comparator\",\n    \"readout\",\n    \"prediction_if_hypothesis_a\",\n    \"prediction_if_hypothesis_b\"\n  ],\n  \"prohibited_interpretations\": [\n    \"Clinical treatment recommendation\",\n    \"Causal conclusion without perturbation evidence\",\n    \"Cross-modality result claimed as same-compartment replication\"\n  ]\n}\n",
